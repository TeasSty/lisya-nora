# Корень сайта на Host-0 (копия public/.htaccess — кладётся в public_html)
# Используйте этот файл ИЛИ скопируйте public/.htaccess после сборки.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /api/* всегда через front controller (не отдавать config.php / lib/*.php как файлы)
  RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

Options -Indexes

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
