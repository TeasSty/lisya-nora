{
  "name": "lisya-nora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply lisya-nora-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lisya-nora-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260916.1": true
  }
}
