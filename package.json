{
  "name": "lisya-nora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply lisya-nora-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lisya-nora-db --remote",
    "build:regru": "tsc -b && vite build --config vite.config.reg.ts",
    "build:host0": "npm run build:regru && node scripts/pack-host0.mjs",
    "start": "tsx server/index.ts",
    "start:regru": "tsx server/index.ts",
    "db:migrate:node": "tsx server/migrate.ts",
    "dev:node": "tsx watch server/index.ts"
  },
  "dependencies": {
    "@vkid/sdk": "^2.6.8",
    "hono": "^4.13.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.133.0",
    "@types/better-sqlite3": "^7.6.13"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260916.1": true,
    "better-sqlite3": true
  }
}
