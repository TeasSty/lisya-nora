# Host-0 / Apache: SPA + PHP API
# Кладётся в корень public_html вместе с index.html и папкой api/

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ВАЖНО: /api/* всегда через front controller — иначе существующие
  # файлы (config.php, lib/*.php) отдаются напрямую из-за правила -f ниже.
  RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

  # Не ломать реальные файлы и папки (статика Vite, images, uploads)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule ^ index.html [L]
</IfModule>

Options -Indexes

# Защита скрытых/служебных
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Defense-in-depth: PHP вне front controller не отдаём напрямую
# (основной маршрут /api/* → api/index.php выше).
<FilesMatch "^(config|bootstrap|hash-password)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Security headers для HTML/статики (API дублирует свои в PHP).
# style-src 'unsafe-inline' — известный компромисс: React/Leaflet ставят inline style.
# script-src без unsafe-inline: ранний scroll-restore вынесен в /early-scroll.js.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  # connect-src: Nominatim для подсказок адреса; OSM tiles грузятся как img (img-src https:).
  # Google Fonts остаются — без них витрина не ломается (системный fallback).
  Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://nominatim.openstreetmap.org https://id.vk.com https://id.vk.ru https://api.vk.com https://login.vk.com https://*.vk.com https://*.vk.ru https://*.userapi.com; frame-src https://id.vk.com https://id.vk.ru https://login.vk.com https://*.vk.com https://*.vk.ru; worker-src 'self' blob:; media-src 'self'"

  # early-scroll.js must not inherit Host-0's multi-week static Expires —
  # otherwise F5 restore fixes never reach browsers after upload.
  <Files "early-scroll.js">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header unset Expires
  </Files>
  # HTML entry always revalidated so asset hashes / ?v= query update.
  <Files "index.html">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header unset Expires
  </Files>
</IfModule>
