# Загрузки товаров: отдавать файлы, запретить выполнение PHP/CGI.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .fcgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps

<IfModule mod_authz_core.c>
  <FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|fcgi)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|fcgi)$">
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

# Отдавать только изображения
<IfModule mod_authz_core.c>
  <FilesMatch "\.(?i:jpe?g|png|gif|webp)$">
    Require all granted
  </FilesMatch>
</IfModule>
