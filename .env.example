# Скопируйте в .env для локальной Node-разработки (не для Host-0 PHP).
# На Host-0 секреты — в api/config.php (admin_password_hash + session_secret).

# Пароль админа только в env на сервере (не коммитьте).
# Hash-at-rest — путь Host-0: php api/hash-password.php → admin_password_hash.
ADMIN_PASSWORD=change-me
# Не короче 16 символов
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/lisya-nora.sqlite

# Опционально
# OZON_DELIVERY_CLIENT_ID=
# OZON_DELIVERY_CLIENT_SECRET=
# OZON_DELIVERY_SCOPE=delivery-api.all

# Сборка фронта (нужен ДО npm run build:regru / build:host0)
# VITE_VKID_APP_ID=
